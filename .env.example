# ─────────────────────────────────────────────────────────────────────────────
# PHASE 0 — required to start. This is the only key you need on day one.
# ─────────────────────────────────────────────────────────────────────────────

# xAI. One key covers ALL inference:
#   grok-4.5 / grok-4.3   chat, reasoning, vision
#   grok-voice-latest     realtime voice  (wss://api.x.ai/v1/realtime)
#   /v1/stt  /v1/tts      transcription, synthesis
#   X Search / Web Search built-in tools, billed per call
# Get it: https://console.x.ai  → API Keys.  Format: xai-...
# Attach a payment method; usage is metered.
XAI_API_KEY=

# Pin model IDs in one place (§14 risk: xAI retired the Grok 3/4 families in May 2026)
XAI_MODEL_REASONING=grok-4.5      # vision, grading, per-slide critique
XAI_MODEL_LONG_CONTEXT=grok-4.3   # whole-deck / whole-corpus passes (1M window)
XAI_MODEL_VOICE=grok-voice-latest
XAI_BASE_URL=https://api.x.ai/v1


# ─────────────────────────────────────────────────────────────────────────────
# PHASE 1 — deck ingestion + pre-read. Add when you start storing artifacts.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres. Neon / Supabase / Railway all fine.
DATABASE_URL=

# Object storage for slide PNGs + session audio (S3 or Cloudflare R2).
# R2 is a good default: S3-compatible, no egress fees.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto

# No key needed — local binaries. Verify they're on PATH / in the container:
#   soffice   LibreOffice headless, PPTX -> PDF   (§2.5)
#   pdfium / poppler                PDF  -> PNG


# ─────────────────────────────────────────────────────────────────────────────
# PHASE 2 — voice. The relay is a separate process from the Next.js app (§2.3).
# ─────────────────────────────────────────────────────────────────────────────

# Public wss:// URL of the relay (Fly / Railway / Render).
NEXT_PUBLIC_RELAY_WS_URL=

# Shared secret so only your app can open a relay session.
# Not a vendor key — generate: openssl rand -hex 32
RELAY_AUTH_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# PHASE 5 — X developer API. NOT needed earlier: brief v1 (Phase 4) runs on
# Grok's built-in X Search, which is covered by XAI_API_KEY above.
# Only add this when you need reply trees + engagement ratios (§4.6).
# ─────────────────────────────────────────────────────────────────────────────

# api.x.com — the SOCIAL PLATFORM api. Separate product from api.x.ai:
# separate auth, separate billing, separate rate limits. One key is NOT both.
# Get it: https://developer.x.com → create Project + App → Keys and tokens.
# Reading public posts only needs the App-only Bearer Token — no OAuth user
# context, no user login flow.
# Pay-per-use since Feb 2026 ($0.005/post read, 2M/mo cap). Free tier is gone —
# a payment method is required.
X_API_BEARER_TOKEN=

# Only if you later need OAuth user context (you don't, for reading):
# X_API_KEY=
# X_API_KEY_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# EXPLICITLY NOT NEEDED — all inference is xAI (§2.5)
# ─────────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY        the `openai` npm client points at api.x.ai; never calls OpenAI
# ANTHROPIC_API_KEY     not used
# DEEPGRAM / ELEVENLABS / CARTESIA / ASSEMBLYAI   xAI does STT+TTS+realtime
# LIVEKIT               plain WebSocket relay is enough for 1:1
# GOOGLE_*              Slides handled by founder exporting to PDF/PPTX
# CLOUDCONVERT          LibreOffice headless, local
